# Configuração de Alertas (Discord / Telegram)
# Preencha pelo menos um deles para receber os avisos.

# 1. Discord (Basta criar um Webhook em um canal do seu servidor)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN

# 2. Telegram (Opcional - crie um bot pelo @BotFather e pegue seu chat_id pelo @userinfobot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
